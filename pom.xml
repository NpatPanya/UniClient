<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.npat.uniclient</groupId>
    <artifactId>uniclient</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <jackson.version>2.22.0</jackson.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

<dependencies>
    <dependency>
        <groupId>jakarta.ws.rs</groupId>
        <artifactId>jakarta.ws.rs-api</artifactId>
        <version>4.0.0</version>
        <scope>provided</scope>
    </dependency>

</dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <excludes>
                        <exclude>com/npat/uniclient/adapter/soap/**</exclude>
                        <exclude>com/npat/uniclient/adapter/codec/JacksonJsonCodec.java</exclude>
                        <exclude>com/npat/uniclient/adapter/codec/JacksonCodecFactory.java</exclude>
                        <exclude>com/npat/uniclient/adapter/codec/PayloadCodecResolver.java</exclude>
                        <exclude>com/npat/uniclient/adapter/StandardAdapterFactories.java</exclude>
                    </excludes>
                    <testExcludes>
                        <testExclude>com/npat/uniclient/adapter/ApacheCxfAdapterPlan3Test.java</testExclude>
                        <testExclude>com/npat/uniclient/adapter/TransportAdaptersPlan3Test.java</testExclude>
                        <testExclude>com/npat/uniclient/codec/SerializationAdaptersPlan4Test.java</testExclude>
                        <testExclude>com/npat/uniclient/plan6/ReadmeExamplesPlan6Test.java</testExclude>
                        <testExclude>com/npat/uniclient/adapter/codec/JacksonJsonCodecTest.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>optional-adapters</id>
            <dependencies>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-frontend-jaxws</artifactId>
                    <version>4.2.2</version>
                    <optional>true</optional>
                </dependency>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-transports-http</artifactId>
                    <version>4.2.2</version>
                    <optional>true</optional>
                </dependency>
                <dependency>
                    <groupId>com.sun.xml.messaging.saaj</groupId>
                    <artifactId>saaj-impl</artifactId>
                    <version>3.0.4</version>
                    <optional>true</optional>
                </dependency>
                <dependency>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                    <version>${jackson.version}</version>
                    <optional>true</optional>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                        <configuration>
                            <excludes combine.self="override"/>
                            <testExcludes combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles></project>